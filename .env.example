# CashLabsAI Environment Variables

# AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# Sentry Monitoring
VITE_SENTRY_DSN=
SENTRY_DSN=

# Stripe Payments
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Configuration
# These are usually loaded from firebase-applet-config.json, 
# but can be overridden here if needed.
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=

# Server Configuration
NODE_ENV=development
PORT=3000
